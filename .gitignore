# Корзина Obsidian
.trash/

# Рабочее пространство и временные данные
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/updates.json

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# История правок плагина edit-history (локальный кэш, не должен попадать в git)
*.edtz

# Экспорт для NotebookLM (собирается скриптом, в git не храним)
_Экспорт/

# Кэш Python (00_Мета/проверка_базы.py и экспорт_в_notebooklm.py при импорте)
__pycache__/
*.py[cod]

# Временные файлы Word и Excel (появляются при открытом документе)
~$*
